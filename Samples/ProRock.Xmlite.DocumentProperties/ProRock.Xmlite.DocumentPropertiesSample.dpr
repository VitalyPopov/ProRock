// These are licensed under the Creative Commons 4.0 Attribution license (https://creativecommons.org/licenses/by/4.0/,
// DCMI: http://dublincore.org/).

uses
  Vcl.Forms,
  Form.Main in 'Form.Main.pas' {MainForm};

{$R *.res}

begin
  Application.Initialize;
  Application.MainFormOnTaskbar := True;
  Application.CreateForm(TMainForm, MainForm);
  Application.Run;
end.
