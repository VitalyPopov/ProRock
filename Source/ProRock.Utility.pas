type
  TFloatFormat = record
    MantissaBits: integer;
    ExponentBits: integer;
    Bias: integer;
    InfinitePower: integer; // the biased exponent of infinity
    SmallestPowerOfTen: integer; // below: zero for any 19 digits
    LargestPowerOfTen: integer; // above: infinity
    MinRoundToEven: integer; // Eisel-Lemire's range where a product can be an exact tie
    MaxRoundToEven: integer;
    function Infinity: UInt64; inline;
    function SignBit: UInt64; inline;
  end;

const
  cDoubleFormat: TFloatFormat = (MantissaBits: 52; ExponentBits: 11; Bias: 1023; InfinitePower: $7FF; SmallestPowerOfTen: -342;
    LargestPowerOfTen: 308; MinRoundToEven: -4; MaxRoundToEven: 23);
  cSingleFormat: TFloatFormat = (MantissaBits: 23; ExponentBits: 8; Bias: 127; InfinitePower: $FF; SmallestPowerOfTen: -64;
    LargestPowerOfTen: 38; MinRoundToEven: -17; MaxRoundToEven: 10);
  cMaxDigits = 19; // that fit a UInt64
  cMaxExactDigits = 800; // more cannot change a Double; past them only a non-zero digit counts

function TFloatFormat.Infinity: UInt64;
begin
  Result := UInt64(InfinitePower) shl MantissaBits;
end;

function TFloatFormat.SignBit: UInt64;
begin
  Result := UInt64(1) shl (MantissaBits + ExponentBits);
end;

procedure Multiply128(a, b: UInt64; out aHigh, aLow: UInt64);
begin
  var a0: UInt64 := Cardinal(a);
  var a1: UInt64 := a shr 32;
  var b0: UInt64 := Cardinal(b);
  var b1: UInt64 := b shr 32;
  var p00: UInt64 := a0 * b0;
  var p01: UInt64 := a0 * b1;
  var p10: UInt64 := a1 * b0;
  var middle: UInt64 := (p00 shr 32) + UInt64(Cardinal(p01)) + UInt64(Cardinal(p10));
  aLow := (middle shl 32) or UInt64(Cardinal(p00));
  aHigh := a1 * b1 + (p01 shr 32) + (p10 shr 32) + (middle shr 32);
end;

function MultiplyHigh(a, b: UInt64): UInt64; inline;
var
  low: UInt64;
begin
  Multiply128(a, b, Result, low);
end;

function LeadingZeros(aValue: UInt64): integer;
begin
  Result := 0;
  if aValue shr 32 = 0 then
  begin
    Inc(Result, 32);
    aValue := aValue shl 32;
  end;
  if aValue shr 48 = 0 then
  begin
    Inc(Result, 16);
    aValue := aValue shl 16;
  end;
  if aValue shr 56 = 0 then
  begin
    Inc(Result, 8);
    aValue := aValue shl 8;
  end;
  if aValue shr 60 = 0 then
  begin
    Inc(Result, 4);
    aValue := aValue shl 4;
  end;
  if aValue shr 62 = 0 then
  begin
    Inc(Result, 2);
    aValue := aValue shl 2;
  end;
  if aValue shr 63 = 0 then
    Inc(Result);
end;

// an arithmetic shift: floor(aValue / 2^aShift), also below zero (shr is logical in Delphi)
function FloorShift(aValue: Int64; aShift: integer): integer; inline;
begin
  if aValue >= 0 then
    Result := aValue shr aShift
  else
    Result := -integer((-aValue - 1) shr aShift) - 1;
end;

// the float nearest to aDigits * 10^aExponent; aExact False: too close to call, may be one off
function EiselLemire(aDigits: UInt64; aExponent: integer; const aFormat: TFloatFormat; out aExact: boolean): UInt64;
var
  productHigh, productLow, nextHigh, nextLow: UInt64;
begin
  aExact := True;
  if (aDigits = 0) or (aExponent < aFormat.SmallestPowerOfTen) then
    Exit(0);
  if aExponent > aFormat.LargestPowerOfTen then
    Exit(aFormat.Infinity);

  var leadingZeroCount: integer := LeadingZeros(aDigits);
  aDigits := aDigits shl leadingZeroCount;
  var index: integer := 2 * (aExponent - cPowerOfFiveMin);
  Multiply128(aDigits, cPowersOfFive[index], productHigh, productLow);
  var precisionMask: UInt64 := High(UInt64) shr (aFormat.MantissaBits + 3);
  if productHigh and precisionMask = precisionMask then
  begin
    Multiply128(aDigits, cPowersOfFive[index + 1], nextHigh, nextLow);
    productLow := productLow + nextHigh;
    if nextHigh > productLow then
      Inc(productHigh);
  end;
  aExact := (productLow <> High(UInt64)) or ((aExponent >= -27) and (aExponent <= 55));

  var upperBit: integer := productHigh shr 63;
  var shift: integer := upperBit + 64 - aFormat.MantissaBits - 3;
  var mantissa: UInt64 := productHigh shr shift;
  var power2: integer := FloorShift(Int64(152170 + 65536) * aExponent, 16) + 63 + upperBit - leadingZeroCount + aFormat.Bias;
  if power2 <= 0 then // subnormal
  begin
    if -power2 + 1 >= 64 then
      Exit(0);
    mantissa := mantissa shr (-power2 + 1);
    Inc(mantissa, mantissa and 1);
    mantissa := mantissa shr 1;
    if mantissa < UInt64(1) shl aFormat.MantissaBits then
      power2 := 0
    else
      power2 := 1;
    Exit((UInt64(power2) shl aFormat.MantissaBits) or (mantissa and ((UInt64(1) shl aFormat.MantissaBits) - 1)));
  end;

  // an exact tie rounds to even, not up
  if (productLow <= 1) and (aExponent >= aFormat.MinRoundToEven) and (aExponent <= aFormat.MaxRoundToEven) and (mantissa and 3 = 1) and
    (mantissa shl shift = productHigh) then
    mantissa := mantissa and not UInt64(1);
  Inc(mantissa, mantissa and 1);
  mantissa := mantissa shr 1;
  if mantissa >= UInt64(2) shl aFormat.MantissaBits then
  begin
    mantissa := UInt64(1) shl aFormat.MantissaBits;
    Inc(power2);
  end;
  mantissa := mantissa and not (UInt64(1) shl aFormat.MantissaBits);
  if power2 >= aFormat.InfinitePower then
    Exit(aFormat.Infinity);
  Result := (UInt64(power2) shl aFormat.MantissaBits) or mantissa;
end;

type
  // a non-negative integer, 32 bits a limb, the lowest first, no zero limbs on top
  TBigNumber = record
    Limbs: TArray<Cardinal>;
    procedure Init(aValue: UInt64);
    procedure MultiplyAdd(aFactor, aAddend: Cardinal);
    procedure MultiplyByPowerOfTen(aPower: integer);
    procedure ShiftLeft(aBits: integer);
    class function Compare(const a, b: TBigNumber): integer; static;
  end;

procedure TBigNumber.Init(aValue: UInt64);
begin
  if aValue = 0 then
    Limbs := nil
  else if aValue shr 32 = 0 then
    Limbs := [Cardinal(aValue)]
  else
    Limbs := [Cardinal(aValue), Cardinal(aValue shr 32)];
end;

procedure TBigNumber.MultiplyAdd(aFactor, aAddend: Cardinal);
begin
  var carry: UInt64 := aAddend;
  for var i := 0 to High(Limbs) do
  begin
    var product: UInt64 := UInt64(Limbs[i]) * aFactor + carry;
    Limbs[i] := Cardinal(product);
    carry := product shr 32;
  end;
  if carry <> 0 then
    Limbs := Limbs + [Cardinal(carry)];
end;

procedure TBigNumber.MultiplyByPowerOfTen(aPower: integer);
const
  cPowers: array [0 .. 9] of Cardinal = (1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000);
begin
  while aPower >= 9 do
  begin
    MultiplyAdd(cPowers[9], 0);
    Dec(aPower, 9);
  end;
  if aPower > 0 then
    MultiplyAdd(cPowers[aPower], 0);
end;

procedure TBigNumber.ShiftLeft(aBits: integer);
begin
  if Limbs = nil then
    Exit;
  var bitShift: integer := aBits mod 32;
  if bitShift <> 0 then
  begin
    var carry: Cardinal := 0;
    for var i := 0 to High(Limbs) do
    begin
      var limb: Cardinal := Limbs[i];
      Limbs[i] := (limb shl bitShift) or carry;
      carry := limb shr (32 - bitShift);
    end;
    if carry <> 0 then
      Limbs := Limbs + [carry];
  end;
  var limbShift: integer := aBits div 32;
  if limbShift > 0 then
  begin
    var zeros: TArray<Cardinal>;
    SetLength(zeros, limbShift);
    FillChar(zeros[0], limbShift * SizeOf(Cardinal), 0);
    Limbs := zeros + Limbs;
  end;
end;

class function TBigNumber.Compare(const a, b: TBigNumber): integer;
begin
  Result := Length(a.Limbs) - Length(b.Limbs);
  var i: integer := High(a.Limbs);
  while (Result = 0) and (i >= 0) do
  begin
    if a.Limbs[i] <> b.Limbs[i] then
      if a.Limbs[i] > b.Limbs[i] then
        Result := 1
      else
        Result := -1;
    Dec(i);
  end;
end;

// aDigits * 10^aExponent against the point halfway between aBits and the next float up
function CompareWithHalfwayUp(const aDigits: string; aExponent: integer; aBits: UInt64; const aFormat: TFloatFormat): integer;
begin
  var mantissa: UInt64 := aBits and ((UInt64(1) shl aFormat.MantissaBits) - 1);
  var power2: integer := aBits shr aFormat.MantissaBits;
  if power2 = 0 then
    power2 := 1
  else
    mantissa := mantissa or (UInt64(1) shl aFormat.MantissaBits);
  power2 := power2 - aFormat.Bias - aFormat.MantissaBits - 1; // halfway = (2 * mantissa + 1) * 2^power2

  var decimal, halfway: TBigNumber;
  decimal.Init(0);
  var i: integer := 1;
  while i <= Length(aDigits) do
  begin
    var chunk: Cardinal := 0;
    var chunkLength: integer := 0;
    while (i <= Length(aDigits)) and (chunkLength < 9) do
    begin
      chunk := chunk * 10 + Cardinal(Ord(aDigits[i]) - Ord('0'));
      Inc(chunkLength);
      Inc(i);
    end;
    if decimal.Limbs = nil then
      decimal.Init(chunk)
    else
    begin
      decimal.MultiplyByPowerOfTen(chunkLength);
      decimal.MultiplyAdd(1, chunk);
    end;
  end;
  halfway.Init(2 * mantissa + 1);
  if aExponent > 0 then
    decimal.MultiplyByPowerOfTen(aExponent)
  else
    halfway.MultiplyByPowerOfTen(-aExponent);
  if power2 > 0 then
    halfway.ShiftLeft(power2)
  else
    decimal.ShiftLeft(-power2);
  Result := TBigNumber.Compare(decimal, halfway);
end;

// the nearest float to aDigits * 10^aExponent exactly, from aBits that may be an ulp or two off
function ExactlyRounded(const aDigits: string; aExponent: integer; aBits: UInt64; const aFormat: TFloatFormat): UInt64;
begin
  Result := aBits;
  while Result < aFormat.Infinity do
  begin
    var comparison: integer := CompareWithHalfwayUp(aDigits, aExponent, Result, aFormat);
    if comparison < 0 then
      Break;
    if (comparison > 0) or Odd(Result) then
      Inc(Result);
    if comparison = 0 then
      Exit;
  end;
  while Result > 0 do
  begin
    var comparison: integer := CompareWithHalfwayUp(aDigits, aExponent, Result - 1, aFormat);
    if comparison > 0 then
      Break;
    if (comparison < 0) or Odd(Result) then
      Dec(Result);
    if comparison = 0 then
      Exit;
  end;
end;

// the RTL's syntax (Delphi 13's; 10.3 - 11 also read "1e" and "."); aDigits: the first 19 digits, aTruncated: a non-zero one after
function ScanDecimal(const aText: string; out aNegative: boolean; out aDigits: UInt64; out aExponent: integer;
  out aTruncated: boolean): boolean;
begin
  aNegative := False;
  aDigits := 0;
  aExponent := 0;
  aTruncated := False;
  var cursor: PChar := PChar(aText);
  while cursor^ = ' ' do
    Inc(cursor);
  if (cursor^ = '-') or (cursor^ = '+') then
  begin
    aNegative := cursor^ = '-';
    Inc(cursor);
  end;

  var anyDigit: boolean := False;
  var significant: integer := 0;
  var inFraction: boolean := False;
  while True do
  begin
    if (cursor^ >= '0') and (cursor^ <= '9') then
    begin
      anyDigit := True;
      if (cursor^ = '0') and (significant = 0) then // a leading zero
      begin
        if inFraction then
          Dec(aExponent);
      end
      else
      begin
        if significant < cMaxDigits then
        begin
          aDigits := aDigits * 10 + UInt64(Ord(cursor^) - Ord('0'));
          if inFraction then
            Dec(aExponent);
        end
        else
        begin
          if not inFraction then
            Inc(aExponent);
          if cursor^ <> '0' then
            aTruncated := True;
        end;
        Inc(significant);
      end;
    end
    else if (cursor^ = '.') and not inFraction then
      inFraction := True
    else
      Break;
    Inc(cursor);
  end;
  if not anyDigit then
    Exit(False);

  if (cursor^ = 'e') or (cursor^ = 'E') then
  begin
    Inc(cursor);
    var exponentNegative: boolean := cursor^ = '-';
    if (cursor^ = '-') or (cursor^ = '+') then
      Inc(cursor);
    if (cursor^ < '0') or (cursor^ > '9') then
      Exit(False);
    var exponent: integer := 0;
    while (cursor^ >= '0') and (cursor^ <= '9') do
    begin
      if exponent < 100000 then // far past any float, and no overflow
        exponent := exponent * 10 + Ord(cursor^) - Ord('0');
      Inc(cursor);
    end;
    if exponentNegative then
      exponent := -exponent;
    Inc(aExponent, exponent);
  end;
  while cursor^ = ' ' do
    Inc(cursor);
  Result := cursor - PChar(aText) = Length(aText); // also refuses a #0 inside
end;

// all significant digits as aDigits * 10^aExponent; past cMaxExactDigits a digit 1 stands for the rest
procedure ExactDecimal(const aText: string; out aDigits: string; out aExponent: integer);
begin
  aDigits := '';
  aExponent := 0;
  var cursor: PChar := PChar(aText);
  var inFraction: boolean := False;
  var sticky: boolean := False;
  while True do
  begin
    if (cursor^ >= '0') and (cursor^ <= '9') then
    begin
      if (cursor^ = '0') and (aDigits = '') then
      begin
        if inFraction then
          Dec(aExponent);
      end
      else if Length(aDigits) < cMaxExactDigits then
      begin
        aDigits := aDigits + cursor^;
        if inFraction then
          Dec(aExponent);
      end
      else
      begin
        if not inFraction then
          Inc(aExponent);
        if cursor^ <> '0' then
          sticky := True;
      end;
    end
    else if cursor^ = '.' then
      inFraction := True
    else if (cursor^ = 'e') or (cursor^ = 'E') or ((cursor^ <> ' ') and (cursor^ <> '+') and (cursor^ <> '-')) then
      Break;
    Inc(cursor);
  end;
  if sticky then
  begin
    aDigits := aDigits + '1';
    Dec(aExponent);
  end;
  if (cursor^ = 'e') or (cursor^ = 'E') then
  begin
    Inc(cursor);
    var exponentNegative: boolean := cursor^ = '-';
    if (cursor^ = '-') or (cursor^ = '+') then
      Inc(cursor);
    var exponent: integer := 0;
    while (cursor^ >= '0') and (cursor^ <= '9') do
    begin
      if exponent < 100000 then
        exponent := exponent * 10 + Ord(cursor^) - Ord('0');
      Inc(cursor);
    end;
    if exponentNegative then
      exponent := -exponent;
    Inc(aExponent, exponent);
  end;
end;

function TryParseFloat(const aText: string; const aFormat: TFloatFormat; out aBits: UInt64): boolean;
var
  negative, truncated, exact: boolean;
  digits: UInt64;
  exponent: integer;
begin
  Result := ScanDecimal(aText, negative, digits, exponent, truncated);
  if not Result then
    Exit;
  aBits := EiselLemire(digits, exponent, aFormat, exact);
  if (truncated or not exact) and (exponent >= aFormat.SmallestPowerOfTen) and
    (exponent <= aFormat.LargestPowerOfTen) then
  begin
    var exactDigits: string;
    ExactDecimal(aText, exactDigits, exponent);
    aBits := ExactlyRounded(exactDigits, exponent, aBits, aFormat);
  end;
  if negative then
    aBits := aBits or aFormat.SignBit;
end;

// Schubfach: floor(log10(2^q)), floor(log10(3/4 * 2^q)), floor(log2(10^e))
function FloorLog10Pow2(q: integer): integer; inline;
begin
  Result := FloorShift(Int64(q) * 661971961083, 41);
end;

function FloorLog10ThreeQuartersPow2(q: integer): integer; inline;
begin
  Result := FloorShift(Int64(q) * 661971961083 - 274743187321, 41);
end;

function FloorLog2Pow10(e: integer): integer; inline;
begin
  Result := FloorShift(Int64(e) * 913124641741, 38);
end;

// the shortest decimal in (aLow, aHigh), bounds included when aOut is 0, the closest to aValue; all 4 x the value at 10^aExponent
procedure ChooseDigits(aValue, aLow, aHigh: UInt64; aOut: integer; aExponent: integer; out aDigits: UInt64; out aDigitsExponent: integer);
begin
  aDigitsExponent := aExponent;
  var s: UInt64 := aValue shr 2;
  if s >= 10 then // Java: s >= 100
  begin
    var sp10: UInt64 := 10 * (s div 10);
    var tp10: UInt64 := sp10 + 10;
    var lowIn: boolean := aLow + UInt64(aOut) <= sp10 shl 2;
    var highIn: boolean := (tp10 shl 2) + UInt64(aOut) <= aHigh;
    if lowIn <> highIn then
    begin
      if lowIn then
        aDigits := sp10
      else
        aDigits := tp10;
      Exit;
    end;
    if lowIn then // both: the closer
    begin
      var middle: UInt64 := (sp10 + tp10) shl 1;
      if (aValue < middle) or ((aValue = middle) and not Odd(sp10 div 10)) then
        aDigits := sp10
      else
        aDigits := tp10;
      Exit;
    end;
  end;
  var t: UInt64 := s + 1;
  var lowIn: boolean := aLow + UInt64(aOut) <= s shl 2;
  var highIn: boolean := (t shl 2) + UInt64(aOut) <= aHigh;
  if lowIn <> highIn then
  begin
    if lowIn then
      aDigits := s
    else
      aDigits := t;
    Exit;
  end;
  var middle: UInt64 := (s + t) shl 1;
  if (aValue < middle) or ((aValue = middle) and not Odd(s)) then
    aDigits := s
  else
    aDigits := t;
end;

// round to odd: the top 64 bits of g * cp, sticky
function RoundToOddDouble(g1, g0, cp: UInt64): UInt64;
const
  cMask63 = UInt64($7FFFFFFFFFFFFFFF);
var
  x1, y0, y1, ignored: UInt64;
begin
  Multiply128(g0, cp, x1, ignored);
  Multiply128(g1, cp, y1, y0);
  var z: UInt64 := (y0 shr 1) + x1;
  Result := (y1 + (z shr 63)) or (((z and cMask63) + cMask63) shr 63);
end;

function RoundToOddSingle(g, cp: UInt64): UInt64;
begin
  var x1: UInt64 := MultiplyHigh(g, cp);
  Result := (x1 shr 31) or (((x1 and $FFFFFFFF) + $FFFFFFFF) shr 32);
end;

// c * 2^q (c > 0) -> aDigits * 10^aExponent
procedure ShortestDecimal(q: integer; c: UInt64; const aFormat: TFloatFormat; out aDigits: UInt64; out aExponent: integer);
begin
  var minimumC: UInt64 := UInt64(1) shl aFormat.MantissaBits;
  var minimumQ: integer := 2 - aFormat.Bias - aFormat.MantissaBits - 1;
  var cOut: integer := c and 1;
  var cb: UInt64 := c shl 2;
  var cbr: UInt64 := cb + 2;
  var cbl: UInt64;
  var k: integer;
  if (c <> minimumC) or (q = minimumQ) then
  begin
    cbl := cb - 2;
    k := FloorLog10Pow2(q);
  end
  else
  begin
    cbl := cb - 1; // the float below is closer: a power of two
    k := FloorLog10ThreeQuartersPow2(q);
  end;
  var index: integer := 2 * (k - cPowerOfTenMin);
  var vb, vbl, vbr: UInt64;
  if aFormat.MantissaBits = 52 then
  begin
    var h: integer := q + FloorLog2Pow10(-k) + 2;
    var g1: UInt64 := cPowersOfTen[index];
    var g0: UInt64 := cPowersOfTen[index + 1];
    vb := RoundToOddDouble(g1, g0, cb shl h);
    vbl := RoundToOddDouble(g1, g0, cbl shl h);
    vbr := RoundToOddDouble(g1, g0, cbr shl h);
  end
  else
  begin
    var h: integer := q + FloorLog2Pow10(-k) + 33;
    var g: UInt64 := cPowersOfTen[index] + 1;
    vb := RoundToOddSingle(g, cb shl h);
    vbl := RoundToOddSingle(g, cbl shl h);
    vbr := RoundToOddSingle(g, cbr shl h);
  end;
  ChooseDigits(vb, vbl, vbr, cOut, k, aDigits, aExponent);
end;

// the shortest decimal that reads back as aBits (positive, finite, not zero), trailing zeros removed
procedure FloatDigits(aBits: UInt64; const aFormat: TFloatFormat; out aDigits: UInt64; out aExponent: integer);
begin
  var minimumC: UInt64 := UInt64(1) shl aFormat.MantissaBits;
  var minimumQ: integer := 2 - aFormat.Bias - aFormat.MantissaBits - 1;
  var t: UInt64 := aBits and (minimumC - 1);
  var biased: integer := aBits shr aFormat.MantissaBits;
  if biased = 0 then
    ShortestDecimal(minimumQ, t, aFormat, aDigits, aExponent)
  else
  begin
    var mq: integer := -minimumQ + 1 - biased;
    var c: UInt64 := minimumC or t;
    if (mq > 0) and (mq <= aFormat.MantissaBits) and ((c shr mq) shl mq = c) then // an integer
    begin
      aDigits := c shr mq;
      aExponent := 0;
    end
    else
      ShortestDecimal(-mq, c, aFormat, aDigits, aExponent);
  end;
  while aDigits mod 10 = 0 do
  begin
    aDigits := aDigits div 10;
    Inc(aExponent);
  end;
end;

// FloatToStrF's ffGeneral form at the precision the digits need (at least aPrecision): fixed from 0.0001 to that many digits
function FloatBitsText(aBits: UInt64; const aFormat: TFloatFormat; aPrecision: integer): string;
var
  digits: UInt64;
  exponent: integer;
begin
  var negative: boolean := aBits and aFormat.SignBit <> 0;
  aBits := aBits and not aFormat.SignBit;
  if aBits = 0 then
    Exit('0'); // as FloatToStr, also for -0
  FloatDigits(aBits, aFormat, digits, exponent);
  var text: string := UIntToStr(digits);
  var count: integer := Length(text);
  var point: integer := exponent + count; // digits before the point
  if (point >= -3) and (point <= Max(aPrecision, count)) then
    if point <= 0 then
      Result := '0.' + StringOfChar('0', -point) + text
    else if point >= count then
      Result := text + StringOfChar('0', point - count)
    else
      Result := Copy(text, 1, point) + '.' + Copy(text, point + 1, count)
  else
  begin
    Result := text[1];
    if count > 1 then
      Result := Result + '.' + Copy(text, 2, count);
    Result := Result + 'E' + IntToStr(point - 1);
  end;
  if negative then
    Result := '-' + Result;
end;

{$IFDEF PROROCK_FLOAT_Q}{$Q+}{$UNDEF PROROCK_FLOAT_Q}{$ENDIF}
{$IFDEF PROROCK_FLOAT_R}{$R+}{$UNDEF PROROCK_FLOAT_R}{$ENDIF}

// the point moved to where the exponent puts it: 1.5E17 -> 150000000000000000
function WithoutExponent(const aText: string): string;
begin
  var digitsStart: PChar := PChar(aText);
  var negative: boolean := digitsStart^ = '-';
  if negative then
    Inc(digitsStart);

  var exponentAt: PChar := digitsStart;
  var digitCount: integer := 0;
  var wholeDigits: integer := -1;
  while (exponentAt^ <> 'E') and (exponentAt^ <> #0) do
  begin
    if exponentAt^ = '.' then
      wholeDigits := digitCount
    else
      Inc(digitCount);
    Inc(exponentAt);
  end;
  if exponentAt^ = #0 then // no exponent; NAN and INF have none to move either
    Exit(aText);
  if wholeDigits < 0 then
    wholeDigits := digitCount;

  var cursor: PChar := exponentAt + 1;
  var negativeExponent: boolean := cursor^ = '-';
  if CharInSet(cursor^, ['-', '+']) then
    Inc(cursor);
  var exponent: integer := 0;
  while cursor^ <> #0 do
  begin
    exponent := exponent * 10 + Ord(cursor^) - Ord('0');
    Inc(cursor);
  end;
  if negativeExponent then
    exponent := -exponent;
  Inc(wholeDigits, exponent);

  var size: integer := Ord(negative);
  if wholeDigits <= 0 then
    Inc(size, 2 - wholeDigits + digitCount)
  else if wholeDigits >= digitCount then
    Inc(size, wholeDigits)
  else
    Inc(size, digitCount + 1);
  SetLength(Result, size);

  var output: PChar := PChar(Result);
  if negative then
  begin
    output^ := '-';
    Inc(output);
  end;
  if wholeDigits <= 0 then
  begin
    output^ := '0';
    output[1] := '.';
    Inc(output, 2);
    for var i := 1 to -wholeDigits do
    begin
      output^ := '0';
      Inc(output);
    end;
  end;

  var written: integer := 0;
  cursor := digitsStart;
  while cursor < exponentAt do
  begin
    if cursor^ <> '.' then
    begin
      if (written = wholeDigits) and (written > 0) then
      begin
        output^ := '.';
        Inc(output);
      end;
      output^ := cursor^;
      Inc(output);
      Inc(written);
    end;
    Inc(cursor);
  end;
  for var i := written + 1 to wholeDigits do
  begin
    output^ := '0';
    Inc(output);
  end;
end;

function ShortestFloatText(aValue: Extended; aFloatType: TFloatType): string;
begin
  if IsNan(aValue) then
    Exit('NaN'); // XML Schema's spelling; the RTL's is NAN

  if IsInfinite(aValue) then
    Exit(FloatToStr(aValue, FormatSettings.Invariant));
  case aFloatType of
    ftSingle:
      begin
        var singleValue: Single := aValue;
        Result := FloatBitsText(PCardinal(@singleValue)^, cSingleFormat, 7);
      end;
    ftDouble:
      begin
        var doubleValue: Double := aValue;
        Result := FloatBitsText(PUInt64(@doubleValue)^, cDoubleFormat, 15);
      end;
  else
{$IF SizeOf(Extended) = SizeOf(Double)}
    if aFloatType = ftExtended then
      Exit(ShortestFloatText(aValue, ftDouble));
{$ENDIF}
    Result := FloatToStr(aValue, FormatSettings.Invariant);
  end;
end;

function FloatText(aValue: Extended; aFloatType: TFloatType; aPlain: boolean): string;
begin
  Result := ShortestFloatText(aValue, aFloatType);
  if aPlain then
    Result := WithoutExponent(Result);
end;

function EnumerationNameWithoutPrefix(aEnumTypeInfo: PTypeInfo; aValue: cardinal): string;
begin
  Result := GetEnumName(aEnumTypeInfo, aValue);

  var resultStartsAt: PChar := PChar(Result);
  while CharInSet(resultStartsAt^, ['a' .. 'z']) do
    Inc(resultStartsAt);

  Result := resultStartsAt;
end;

function GetEnumerationName(aEnumTypeInfo: PTypeInfo; aValue: cardinal): string;
begin
  Result := TUtility.FromPascalCase(EnumerationNameWithoutPrefix(aEnumTypeInfo, aValue), nCamelCase);
end;

function GetEnumerationName(aEnumTypeInfo: PTypeInfo; aValue: cardinal; aNaming: TNaming): string;
begin
  Result := TUtility.FromPascalCaseExact(EnumerationNameWithoutPrefix(aEnumTypeInfo, aValue), aNaming);
end;

function SimplifiedGenericName(const aName: string): string;
begin
  SetString(Result, PChar(aName), Length(aName));

  var openBracket: integer := Result.IndexOf('<');
  if openBracket < 0 then
    Exit;
  var destination: PChar := PChar(Result) + openBracket + 1;

  var source: PChar := PChar(Result) + High(Result);
  while source^ <> '.' do
  begin
    if source = destination then
      Exit;
    Dec(source);
  end;
  Inc(source);

  repeat
    destination^ := source^;
    Inc(source);
    Inc(destination);
  until source^ = #0;
  SetLength(Result, destination - PChar(Result));
end;

{ TNamingAttribute }

constructor TNamingAttribute.Create(aNaming: TNaming);
begin
  fNaming := aNaming;
end;

{ THashedObjectList<T> }

procedure THashedObjectList<T>.Add(const aValue: T);
begin
  if fDictionary.ContainsKey(aValue) then
    Exit;

  fDictionary.Add(aValue, fList.Add(aValue));
end;

function THashedObjectList<T>.Contains(const aValue: T): boolean;
begin
  Result := fDictionary.ContainsKey(aValue);
end;

constructor THashedObjectList<T>.Create(aOwnsObjects: boolean);
begin
  fList := TObjectList<T>.Create(aOwnsObjects);
  fDictionary := TObjectDictionary<T, integer>.Create;
end;

destructor THashedObjectList<T>.Destroy;
begin
  fDictionary.Free;
  fList.Free;
  inherited;
end;

function THashedObjectList<T>.GetCount: integer;
begin
  Result := fList.Count;
end;

function THashedObjectList<T>.GetValue(const aIndex: integer): T;
begin
  Result := fList[aIndex];
end;

function THashedObjectList<T>.GetValues: TEnumerable<T>;
begin
  Result := fList;
end;

procedure THashedObjectList<T>.Remove(const aValue: T);
begin
  if fDictionary.ContainsKey(aValue) then
  begin
    fDictionary.Remove(aValue);
    fList.Delete(fDictionary[aValue]);
  end;
end;

{ TDictObjectList<K, V> }

procedure TDictObjectList<K, V>.Add(const aKey: K; const aValue: V);
begin
  if fDictionary.ContainsKey(aKey) then
  begin
    var listIndex: integer := fKeys.IndexOf(aKey);
    fKeys.Delete(listIndex);
    fValues.Delete(listIndex);
  end;

  fKeys.Add(aKey);
  fValues.Add(aValue);
  fDictionary.AddOrSetValue(aKey, aValue);
end;

procedure TDictObjectList<K, V>.AddAnother(const aKey: K; const aValue: V);
begin
  fKeys.Add(aKey);
  fValues.Add(aValue);
  fDictionary.TryAdd(aKey, aValue);
end;

procedure TDictObjectList<K, V>.Clear;
begin
  fDictionary.Clear;
  fKeys.Clear;
  fValues.Clear;
end;

constructor TDictObjectList<K, V>.Create(aComparer: IComparer<K>; aEqualityComparer: IEqualityComparer<K>; aOwnsValues: boolean);
begin
  fKeys := TList<K>.Create(aComparer);
  fValues := TObjectList<V>.Create(aOwnsValues);
  fDictionary := TObjectDictionary<K, V>.Create([], aEqualityComparer);
end;

constructor TDictObjectList<K, V>.Create(aOwnsValues: boolean);
begin
  fKeys := TList<K>.Create;
  fValues := TObjectList<V>.Create(aOwnsValues);
  fDictionary := TObjectDictionary<K, V>.Create([]);
end;

destructor TDictObjectList<K, V>.Destroy;
begin
  fDictionary.Free;
  fValues.Free;
  fKeys.Free;
  inherited;
end;

function TDictObjectList<K, V>.GetCount: integer;
begin
  Result := fKeys.Count;
end;

function TDictObjectList<K, V>.GetValue(const aKey: K): V;
begin
  if not fDictionary.TryGetValue(aKey, Result) then
    Result := nil;
end;

procedure TDictObjectList<K, V>.Remove(const aIndex: integer);
begin
  if not InRange(aIndex, 0, fKeys.Count - 1) then
    Exit;

  fDictionary.Remove(fKeys[aIndex]);
  fKeys.Delete(aIndex);
  fValues.Delete(aIndex);
end;

procedure TDictObjectList<K, V>.Remove(const aKey: K);
begin
  Remove(fKeys.IndexOf(aKey));
end;

{ TDualDictionary<TKey, TValue> }

procedure TDualDictionary<TKey, TValue>.Add(const aKey: TKey; const aValue: TValue);
begin
  if fKeyValue.ContainsKey(aKey) then
  begin
    fValueKey.Remove(fKeyValue[aKey]);
    fKeyValue.Remove(aKey);
  end;
  if fValueKey.ContainsKey(aValue) then
  begin
    fKeyValue.Remove(fValueKey[aValue]);
    fValueKey.Remove(aValue);
  end;

  fKeyValue.Add(aKey, aValue);
  fValueKey.Add(aValue, aKey);
end;

constructor TDualDictionary<TKey, TValue>.Create;
begin
  fKeyValue := TDictionary<TKey, TValue>.Create;
  fValueKey := TDictionary<TValue, TKey>.Create;
end;

destructor TDualDictionary<TKey, TValue>.Destroy;
begin
  fKeyValue.Free;
  fValueKey.Free;
  inherited;
end;

function TDualDictionary<TKey, TValue>.GetCount: NativeInt;
begin
  Result := fKeyValue.Count;
end;

function TDualDictionary<TKey, TValue>.TryGetKeyByValue(const aValue: TValue; out aKey: TKey): boolean;
begin
  Result := fValueKey.TryGetValue(aValue, aKey);
end;

function TDualDictionary<TKey, TValue>.TryGetValueByKey(const aKey: TKey; out aValue: TValue): boolean;
begin
  Result := fKeyValue.TryGetValue(aKey, aValue);
end;

{ TWriterBase }

procedure TWriterBase.AddIndent;
begin
  if (fLevel = 0) or (fIndent = 0) then
    Exit;

  for var i := 0 to fLevel * fIndent - 1 do
    Write(' ');
end;

procedure TWriterBase.AddLine(const aLine: string);
begin
  var start: PChar := PChar(aLine);
  var increasedLevel: boolean := False; // for multiline wrap

  AddIndent;

  if fWidth > 0 then
  begin
    var stringLength: integer := Length(start);

    while cardinal(stringLength) + fIndent > fWidth do
    begin
      var cursor: PChar := start + fWidth - fIndent;

        // find space prior
      while (cursor <> start) and (cursor^ <> #32) do
        Dec(cursor);

      if cursor = start then
      begin // find space after
        cursor := start + fWidth - fIndent;

        while (cursor <> start + stringLength) and (cursor^ <> #32) do
          Inc(cursor);
      end;

      if cursor^ <> #32 then // no space left in string -> write it as is
        Break;

      cursor^ := #0;
      Write(start);
      cursor^ := #32;

      start := cursor + 1;
      stringLength := Length(start);

      if not increasedLevel then
      begin // increase indent for further lines
        IncLevel;
        increasedLevel := True;
      end;

      FinishLine;
      AddIndent;
    end;
  end;

  Write(start);
  FinishLine;

  if increasedLevel then
    DecLevel;
end;

procedure TWriterBase.AddLine(const aFormat: string; aArgs: array of const);
begin
  AddLine(Format(aFormat, aArgs));
end;

constructor TWriterBase.Create(aIndent, aWidth, aLevel: cardinal);
begin
  Create(nil, aIndent, aWidth, aLevel);
end;

constructor TWriterBase.Create(aStream: TStream; aIndent, aWidth, aLevel: cardinal);
begin
  if aStream = nil then
  begin
    // UTF-8, as TStreamWriter writes (TStringStream's default is the ANSI code page); the shared instance is not owned
    inherited Create(TStringStream.Create('', TEncoding.UTF8, False));
    OwnStream;
  end
  else
    inherited Create(aStream);

  fIndent := aIndent;
  fWidth := aWidth;
  fLevel := aLevel;
end;

procedure TWriterBase.FinishLine(const aEndingText: string);
begin
  Write(aEndingText);
  Write([#13, #10]);
end;

function TWriterBase.GetText: string;
begin
  if not BaseStream.ClassType.InheritsFrom(TStringStream) then
    Exit;

  Result := TStringStream(BaseStream).DataString;
end;

procedure TWriterBase.DecLevel;
begin
  Dec(fLevel);
end;

procedure TWriterBase.IncLevel;
begin
  Inc(fLevel);
end;

{ TReaderBase }

class function TReaderBase.ReadInteger(var aCursor: PChar; aHex: boolean): integer;
begin
  Result := 0;
  if aCursor = nil then
    Exit;

  while (aHex and CharInSet(aCursor^, ['0' .. '9', 'a' .. 'f', 'A' .. 'F'])) or (not aHex and CharInSet(aCursor^, ['0' .. '9'])) do
  begin
    var digit: Integer;
    if CharInSet(aCursor^, ['0' .. '9']) then
      digit := Ord(aCursor^) - Ord('0')
    else
      digit := Ord(UpCase(aCursor^)) - Ord('A') + 10;
    Inc(aCursor);

    if (Result > cIntegerMaxDiv[aHex]) or ((Result = cIntegerMaxDiv[aHex]) and (digit > cIntegerMaxMod[aHex])) then
      Exit(0); // overflow
    Result := Result * IfThen(aHex, 16, 10) + digit;
  end;
end;

class function TReaderBase.MoveToChar(var aCursor: PChar; aChar: Char): boolean;
begin
  if aCursor = nil then
    Exit(False);

  while aCursor^ <> aChar do
  begin
    if aCursor^ = #0 then
      Exit(False); // end of string
    Inc(aCursor);
  end;

  Result := True;
end;

// This function will not work as expected if 'aChars' contains non-ASCII characters.
class function TReaderBase.MoveToChars(var aCursor: PChar; const aChars: TSysCharSet): boolean;
begin
  Result := False;
  if (aCursor = nil) or (aChars = []) then
    Exit;

  while aCursor^ <> #0 do
  begin
    if CharInSet(aCursor^, aChars) then
      Exit(True);
    Inc(aCursor);
  end;
end;

class function TReaderBase.MoveToVisualChar(var aCursor: PChar): boolean;
begin
  if aCursor = nil then
    Exit(False);

  // Skip over control characters and non-printable ASCII characters. Printable ASCII characters start at #33 and above.
  while aCursor^ <= #32 do
  begin
    if aCursor^ = #0 then
      Exit(False); // end of string
    Inc(aCursor);
  end;

  Result := True;
end;

class function TReaderBase.PassQuotes(var aCursor: PChar; aQuoteChar: Char): boolean;
begin
  Result := False;

  if not MoveToChar(aCursor, aQuoteChar) then
    Exit;
  Inc(aCursor);

  if not MoveToChar(aCursor, aQuoteChar) then
    Exit;
  Inc(aCursor);

  Result := True;
end;

{ TUtility }

class function TUtility.Acronym(const aName: string; aAcronyms: THashSet<string>): string;
const cAlphabet = 'abcdefghijklmnopqrstuvwxyz';
begin
  Result := ToPascalCase(aName);
  if Result.IsEmpty then // PChar('') is a constant: the #0 below would be written into it
    Exit;
  var cursor: PChar := PChar(Result);
  var acronymCursor: PChar := cursor;
  while cursor^ <> #0 do
  begin
    if CharInSet(cursor^, ['A' .. 'Z']) then
    begin
      acronymCursor^ := cursor^;
      Inc(acronymCursor^, 32);
      Inc(acronymCursor);
    end;
    Inc(cursor);
  end;
  acronymCursor^ := #0;
  Result := PChar(Result);

  // taken: the acronym, then + a..z, + aa..zz and so on (one letter only gave the 27th taker its 26th's name)
  if aAcronyms <> nil then
  begin
    var acronym: string := Result;
    var index: integer := 0;
    while aAcronyms.Contains(Result) do
    begin
      Inc(index);
      var suffix: string := '';
      var rest: integer := index;
      while rest > 0 do
      begin
        Dec(rest);
        suffix := cAlphabet[rest mod Length(cAlphabet) + 1] + suffix;
        rest := rest div Length(cAlphabet);
      end;
      Result := acronym + suffix;
    end;
    aAcronyms.Add(Result);
  end;
end;

class function TUtility.ExePath: string;
begin
  Result := ExtractFilePath(ParamStr(0));
end;

class function TUtility.FloatFitsComp(aValue: Extended): boolean;
begin
  Result := not IsNan(aValue) and (Abs(aValue) < 9223372036854775808.0); // 2^63; infinity is above it
end;

class function TUtility.FromPascalCase(const aName: string; aNaming: TNaming): string;

  function SplitPascalCase(const aName: string): TArray<string>; inline;
  begin
    Result := [];
    var cursor: PChar := PChar(aName);
    var wordStart: PChar := cursor;
    var currentWord: string;
    while cursor^ <> #0 do
    begin
      if CharInSet(cursor^, ['A' .. 'Z']) and (cursor > wordStart) then
      begin
        SetString(currentWord, wordStart, cursor - wordStart);
        Result := Result + [currentWord];
        wordStart := cursor;
      end;
      Inc(cursor);
    end;

    if wordStart <> cursor then
    begin
      SetString(currentWord, wordStart, cursor - wordStart);
      Result := Result + [currentWord];
    end;
  end;

begin
  SetString(Result, PChar(aName), Length(aName));
  if (aNaming = nPascalCase) or Result.IsEmpty then
    Exit;

  var inputNaming: TNaming := GuessNaming(Result);
  if (inputNaming <> nPascalCase) or (inputNaming = nAsIs) then
    Exit;

  case aNaming of
    nSnakeCase, nCapsCase, nTitleCase, nKebabCase, nCobolCase, nTrainCase:
      begin
        var words: TArray<string> := SplitPascalCase(Result);

        for var i := 0 to High(words) do
        begin
          if aNaming in [nCobolCase, nCapsCase] then
            words[i] := words[i].ToUpper;
          if (aNaming in [nSnakeCase, nKebabCase]) and not words[i].IsEmpty then
            Inc(words[i][1], 32);
        end;

        case aNaming of
          nSnakeCase, nCapsCase, nTitleCase:
            Result := string.Join('_', words);
          nKebabCase, nCobolCase, nTrainCase:
            Result := string.Join('-', words);
        end;
      end;
    nCamelCase:
      Inc(Result[1], 32);
    nFlatCase:
      Result := Result.ToLower;
    nUpperCase:
      Result := Result.ToUpper;
  end;
end;

class function TUtility.FromPascalCaseExact(const aName: string; aNaming: TNaming): string;
begin
  if (GuessNaming(aName) = nUpperCase) and (aNaming in [nCamelCase, nSnakeCase, nKebabCase, nFlatCase]) then
    Result := aName.ToLower
  else
    Result := TUtility.FromPascalCase(aName, aNaming);
end;

class function TUtility.NamingOf(const aName: string): TNaming;
begin
  Result := GuessNaming(aName);
  if (Result <> nAsIs) and (TUtility.FromPascalCase(ToPascalCase(aName), Result) <> aName) then
    Result := nAsIs;
end;

class function TUtility.GuessNaming(const aName: string): TNaming;
begin
  Result := nAsIs;

  if aName.IsEmpty then
    Exit;

  var cursor: PChar := PChar(aName);
  if not CharInSet(cursor^, cNameStartChars) then
    Exit; // Invalid starting character

  var hasUnderscore: boolean := False;
  var hasHyphen: boolean := False;
  var hasLower: boolean := False;
  var hasUpper: boolean := False;
  var firstCharUpper: boolean := False;

  if CharInSet(cursor^, ['A' .. 'Z']) then
    firstCharUpper := True;

  while cursor^ <> #0 do
  begin
    if not CharInSet(cursor^, cNameChars) then
      Exit;

    case cursor^ of
      '_':
        hasUnderscore := True;
      '-':
        hasHyphen := True;
      'a' .. 'z':
        hasLower := True;
      'A' .. 'Z':
        hasUpper := True;
    end;

    Inc(cursor);
  end;

  if hasUnderscore then
    if hasUpper and not hasLower then
      Result := nCapsCase // CAPS_CASE
    else if firstCharUpper then
      Result := nTitleCase // Title_Case
    else
      Result := nSnakeCase // snake_case
  else if hasHyphen then
    if hasUpper and not hasLower then
      Result := nCobolCase // COBOL-CASE
    else if firstCharUpper then
      Result := nTrainCase // Train-Case
    else
      Result := nKebabCase // kebab-case
  else if hasUpper and hasLower then
    if firstCharUpper then
      Result := nPascalCase // PascalCase
    else
      Result := nCamelCase // camelCase
  else if hasUpper and not hasLower then
    Result := nUpperCase // UPPERCASE
  else if hasLower and not hasUpper then
    Result := nFlatCase; // flatcase
end;

class function TUtility.IsFileError(aError: Exception): boolean;
begin
  // 10.3 - 10.4: EFileNotFoundException and its kin are no EInOutError yet
  Result := aError.InheritsFrom(EStreamError) or aError.InheritsFrom(EInOutError) or aError.InheritsFrom(EZipException) or
    aError.InheritsFrom(EEncodingError) or aError.InheritsFrom(EOSError) or aError.InheritsFrom(EFileNotFoundException) or
    aError.InheritsFrom(EDirectoryNotFoundException) or aError.InheritsFrom(EPathTooLongException);
end;

class function TUtility.IsDebugging: boolean;
begin
  {$WARN SYMBOL_PLATFORM OFF}
  Result := DebugHook <> 0;
  {$WARN SYMBOL_PLATFORM ON}
end;

class function TUtility.NameAndPrefix(const aFullName: string; out aPrefix, aName: string; aSeparator: Char): boolean;
begin
  Result := True;
  if aFullName.IsEmpty then
    Exit(False);

  aPrefix := Prefix(aFullName, aSeparator);
  if aPrefix.IsEmpty then
    aName := aFullName
  else
    aName := PChar(aFullName) + Length(aPrefix) + 1 {separator};
end;

class function TUtility.NameWithoutPrefix(const aName: string; aSeparator: Char): string;
begin
  var cursor: PChar := PChar(aName);
  while cursor^ <> #0 do
  begin
    if cursor^ = aSeparator then
      Exit(cursor + 1);

    Inc(cursor);
  end;

  Result := aName;
end;

class function TUtility.Prefix(const aName: string; aSeparator: Char): string;
begin
  var cursor: PChar := PChar(aName);
  while cursor^ <> #0 do
  begin
    if cursor^ = aSeparator then
    begin
      cursor^ := #0;
      Result := PChar(aName);
      cursor^ := aSeparator;
      Exit;
    end;

    Inc(cursor);
  end;

  Result := '';
end;

class function TUtility.ToPascalCase(const aName: string): string;
begin
  SetString(Result, PChar(aName), Length(aName)); // for AsIs or PascalCase
  if Result.IsEmpty then
    Exit;

  // a dot separates words (XHTML a.content, FHIR Account.Coverage) - never part of a Delphi name; each word in its own style
  if Result.IndexOf('.') >= 0 then
  begin
    var dotWords: TArray<string> := Result.Split(['.']);
    Result := '';
    for var dotWord: string in dotWords do
      Result := Result + ToPascalCase(dotWord);
    Exit;
  end;

  var originalNaming: TNaming := GuessNaming(Result);;
  case originalNaming of
    nSnakeCase, nCapsCase, nTitleCase, nKebabCase, nCobolCase, nTrainCase:
      begin
        var words: TArray<string>;;
        case originalNaming of
          nSnakeCase, nCapsCase, nTitleCase:
            words := Result.Split(['_']);
          nKebabCase, nCobolCase, nTrainCase:
            words := Result.Split(['-']);
        end;

        for var i := 0 to High(words) do
        begin
          if originalNaming in [nCobolCase, nCapsCase] then
            words[i] := words[i].ToLower;
          if not words[i].IsEmpty then
            words[i][1] := UpCase(words[i][1]);
        end;

        Result := string.Join('', words);
      end;
    nCamelCase, nFlatCase:
      Result[1] := UpCase(Result[1]);
    nUpperCase:
      begin
        Result := Result.ToLower;
        Result[1] := UpCase(Result[1]);
      end;
  end;
end;

class function TUtility.TryFloatFromText(const aText: string; out aValue: Single): boolean;
begin
  Result := True;
  if aText = 'NaN' then
    aValue := NaN
  else if aText = 'INF' then
    aValue := Infinity
  else if aText = '-INF' then
    aValue := NegInfinity
  else
  begin
    var bits: UInt64;
    Result := TryParseFloat(aText, cSingleFormat, bits);
    if not Result then
      bits := 0;
    PCardinal(@aValue)^ := Cardinal(bits);
  end;
end;

class function TUtility.TryFloatFromText(const aText: string; out aValue: Double): boolean;
begin
  Result := True;
  if aText = 'NaN' then
    aValue := NaN
  else if aText = 'INF' then
    aValue := Infinity
  else if aText = '-INF' then
    aValue := NegInfinity
  else
  begin
    var bits: UInt64;
    Result := TryParseFloat(aText, cDoubleFormat, bits);
    if not Result then
      bits := 0;
    PUInt64(@aValue)^ := bits;
  end;
end;

class function TUtility.TryFloatFromText(const aText: string; out aValue: Extended): boolean;
begin
{$IF SizeOf(Extended) = SizeOf(Double)}
  var doubleValue: Double;
  Result := TryFloatFromText(aText, doubleValue);
  aValue := doubleValue;
{$ELSE} // 10 bytes (Win32): the RTL's (hand-written classes only)
  Result := True;
  if aText = 'NaN' then
    aValue := NaN
  else if aText = 'INF' then
    aValue := Infinity
  else if aText = '-INF' then
    aValue := NegInfinity
  else
    Result := TryStrToFloat(aText, aValue, FormatSettings.Invariant);
{$ENDIF}
end;

{ TSummaryDictionary }

constructor TSummaryDictionary<T>.Create(aFirstItem: T);
begin
  Create;
  if aFirstItem <> nil then
    Increase(aFirstItem);
end;

constructor TSummaryDictionary<T>.Create;
begin
  fDictionary := TDictionary<T, cardinal>.Create;
end;

function TSummaryDictionary<T>.Decrease(const aItem: T): boolean;
begin
  var summary: cardinal := 0;
  Result := fDictionary.TryGetValue(aItem, summary);

  if Result then
  begin
    Dec(summary);

    if summary = 0 then
      fDictionary.Remove(aItem)
    else
      fDictionary[aItem] := summary;
  end;
end;

destructor TSummaryDictionary<T>.Destroy;
begin
  fDictionary.Free;
  inherited;
end;

function TSummaryDictionary<T>.GetCount: integer;
begin
  Result := fDictionary.Count;
end;

function TSummaryDictionary<T>.Increase(const aItem: T): cardinal;
begin
  if fDictionary.TryGetValue(aItem, Result) then
    Inc(Result)
  else
    Result := 1;

  fDictionary.AddOrSetValue(aItem, Result);
end;

{$IF CompilerVersion < 36.0} // Delphi < 12

{ THashSet<T> }

constructor THashSet<T>.Create;
begin
  fDictionary := TDictionary<T, Byte>.Create;
end;

constructor THashSet<T>.Create(const AItems: array of T; const AComparer: IEqualityComparer<T>);
begin
  fDictionary := TDictionary<T, Byte>.Create(AComparer);
  for var item: T in AItems do
    fDictionary.TryAdd(item, 0);
end;

destructor THashSet<T>.Destroy;
begin
  fDictionary.Free;
  inherited;
end;

function THashSet<T>.GetEnumerator: TDictionary<T, Byte>.TKeyEnumerator;
begin
  Result := fDictionary.Keys.GetEnumerator;
end;

procedure THashSet<T>.Clear;
begin
  fDictionary.Clear;
end;

function THashSet<T>.Add(const Value: T): Boolean;
begin
  Result := fDictionary.TryAdd(Value, 0);
end;

function THashSet<T>.Contains(const Value: T): Boolean;
begin
  Result := fDictionary.ContainsKey(Value);
end;

{$ENDIF}

end.
