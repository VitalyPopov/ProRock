program ProRock.Soapite.WsSecuritySample;

{$APPTYPE CONSOLE}

// WS-Security UsernameToken (OASIS WSS 1.0, UsernameToken Profile) in the SOAP header of a generated client:
// - ProRock.Xmlite.Schema.WsSecurity/.WsSecurityUtility are generated by ProRocket from the official OASIS schemas
//   (oasis-200401-wss-wssecurity-secext-1.0.xsd, -utility-1.0.xsd, included here)
// - OnRequestHeader adds wsse:Security with a Timestamp and a UsernameToken: Username, Password as PasswordDigest
//   (Base64(SHA-1(nonce + created + password))), Nonce, wsu:Created - what services secured this way expect
// - the client is the generated Calculator client of the ProRock.Soapite.Calculator sample
// By default nothing is sent: a printing transport shows the request as a service would receive it and answers like the
// Calculator service. With -live the request goes to the public Calculator service, which ignores the header (no
// mustUnderstand) - the header travels over the wire all the same.
// Usage: ProRock.Soapite.WsSecuritySample [-live]

uses
  System.SysUtils,
  System.DateUtils,
  System.Hash,
  System.NetEncoding,
  System.StrUtils,
  ProRock.Basite,
  ProRock.Xmlite,
  ProRock.Http,
  ProRock.Xmlite.Schema.WsSecurityUtility in 'ProRock.Xmlite.Schema.WsSecurityUtility.pas',
  ProRock.Xmlite.Schema.WsSecurity in 'ProRock.Xmlite.Schema.WsSecurity.pas',
  ProRock.Xmlite.Schema.Calculator in '..\ProRock.Soapite.Calculator\ProRock.Xmlite.Schema.Calculator.pas',
  ProRock.Soapite.Calculator in '..\ProRock.Soapite.Calculator\ProRock.Soapite.Calculator.pas';

const
  // sample credentials - a real service gives you yours (never put them in source code)
  cUserName = 'demo';
  cPassword = 'demo-secret';

  cPasswordDigest = 'http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordDigest';
  cBase64Binary = 'http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-soap-message-security-1.0#Base64Binary';

  // what the Calculator service answers to Add(2, 3)
  cAddResponse = '<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"><soap:Body>' +
    '<AddResponse xmlns="http://tempuri.org/"><AddResult>5</AddResult></AddResponse></soap:Body></soap:Envelope>';

type
  // offline: prints the request as a service would receive it and answers like the Calculator service
  TPrintingTransport = class(THttpTransport)
  protected
    function Send(const aRequest: THttpRequest): THttpResponse; override;
  end;

  TSecurityHeader = class
  public
    // OnRequestHeader: the header block is an Xmlite object - owned by the envelope once added
    class procedure AddUsernameToken(aSender: TObject; aHeader: TXmlite);
    class procedure PrintRequest(aSender: TObject; const aXml: string);
  end;

{ TPrintingTransport }

function TPrintingTransport.Send(const aRequest: THttpRequest): THttpResponse;
begin
  Writeln(aRequest.Method, ' ', aRequest.Url);
  for var header: THttpHeader in aRequest.Headers do
    Writeln(header.Name, ': ', header.Value);
  Writeln;
  Writeln(aRequest.Body);
  Writeln;

  Result.Status := 200;
  Result.Headers := [];
  Result.Body := cAddResponse;
end;

// UsernameToken Profile 1.0: Password_Digest = Base64(SHA-1(nonce + created + password)), the nonce as raw bytes
function PasswordDigest(const aNonce: TBytes; const aCreated, aPassword: string): string;
begin
  var sha1: THashSHA1 := THashSHA1.Create;
  sha1.Update(aNonce + TEncoding.UTF8.GetBytes(aCreated) + TEncoding.UTF8.GetBytes(aPassword));
  Result := TNetEncoding.Base64String.EncodeBytesToString(sha1.HashAsBytes);
end;

{ TSecurityHeader }

class procedure TSecurityHeader.AddUsernameToken(aSender: TObject; aHeader: TXmlite);
begin
  var now: TDateTime := TTimeZone.Local.ToUniversalTime(System.SysUtils.Now);
  var created: string := DateToISO8601(now, True); // UTC, e.g. 2026-10-13T12:00:00.000Z

  // 16 random bytes, used once (a GUID here; a cryptographic generator is the stricter choice)
  var guid: TGUID := TGUID.NewGuid;
  var nonce: TBytes;
  SetLength(nonce, SizeOf(guid));
  Move(guid, nonce[0], SizeOf(guid));

  var security: TSecurityE := TSecurityE.Create;

  var timestamp: TTimestampE := TTimestampE.Create;
  timestamp.Id := 'TS-1';
  timestamp.Created.XmlValue := created;
  timestamp.Expires.XmlValue := DateToISO8601(IncMinute(now, 5), True);
  security.XmlAny.Add(timestamp);

  // the schema declares only Username; Password, Nonce and Created come in through xs:any - as typed elements
  var token: TUsernameTokenE := TUsernameTokenE.Create;
  token.Id := 'UT-1';
  token.Username.XmlValue := cUserName;

  var password: TPasswordE := TPasswordE.Create;
  password.&Type := cPasswordDigest;
  password.XmlValue := PasswordDigest(nonce, created, cPassword);
  token.XmlAny.Add(password);

  var nonceElement: TNonceE := TNonceE.Create;
  nonceElement.EncodingType := cBase64Binary;
  nonceElement.XmlValue := TNetEncoding.Base64String.EncodeBytesToString(nonce);
  token.XmlAny.Add(nonceElement);

  var tokenCreated: TCreatedE := TCreatedE.Create;
  tokenCreated.XmlValue := created;
  token.XmlAny.Add(tokenCreated);

  security.XmlAny.Add(token);
  aHeader.XmlAny.Add(security);
end;

class procedure TSecurityHeader.PrintRequest(aSender: TObject; const aXml: string);
begin
  Writeln('Request sent:');
  Writeln(aXml);
  Writeln;
end;

begin
  ReportMemoryLeaksOnShutdown := True;
  TBasite.Pretty := True; // readable XML

  try
    var live: boolean := FindCmdLineSwitch('live');

    var calculator: TCalculator := TCalculator.Create; // the endpoint from the WSDL
    try
      if live then
        calculator.OnRequest := TSecurityHeader.PrintRequest
      else
        calculator.Transport := TPrintingTransport.Create; // owned by the client
      calculator.OnRequestHeader := TSecurityHeader.AddUsernameToken;

      var request: TAddE := TAddE.Create;
      try
        request.IntA := 2;
        request.IntB := 3;

        var response: TAddResponseE;
        var error: TSoapiteError;
        if calculator.TryAdd(request, response, error) then
          try
            Writeln('2 + 3 = ', response.AddResult, IfThen(live, ' (from the live service)', ' (the printing transport''s answer)'));
          finally
            response.Free;
          end
        else
          Writeln('failed [', error.Code, ']: ', error.Message);
      finally
        request.Free;
      end;
    finally
      calculator.Free;
    end;
  except
    on e: Exception do
      Writeln(e.ClassName, ': ', e.Message);
  end;

  Writeln;
  Write('Press <Enter> to quit.');
  Readln;
end.
